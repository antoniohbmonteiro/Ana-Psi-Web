rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{documentId} {
      allow get: if documentId in ['site_public_profile', 'site_public_landing'];
      allow list, write: if false;
    }
    match /appointments/{document=**} {
      allow read, write: if false;
    }
    // Administrative writes use the Admin SDK on the server; clients never touch these collections.
    match /patients/{document=**} {
      allow read, write: if false;
    }
    match /appointmentDays/{document=**} {
      allow read, write: if false;
    }
    match /idempotencyKeys/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
