{
  "name": "ana-psi-web",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/public",
    "apps/admin"
  ],
  "scripts": {
    "dev:public": "npm run dev --workspace @ana-psi/public",
    "dev:admin": "npm run dev --workspace @ana-psi/admin",
    "build:public": "npm run build --workspace @ana-psi/public",
    "build:admin": "npm run build --workspace @ana-psi/admin",
    "lint:public": "npm run lint --workspace @ana-psi/public",
    "lint:admin": "npm run lint --workspace @ana-psi/admin",
    "typecheck:admin": "npm run typecheck --workspace @ana-psi/admin",
    "deploy:public": "npm run deploy:hosting --workspace @ana-psi/public",
    "emulators:admin": "npm run emulators --workspace @ana-psi/admin",
    "seed:admin": "npm run seed --workspace @ana-psi/admin",
    "test:security:admin": "npm run test:security --workspace @ana-psi/admin",
    "test:integration:admin": "npm run test:integration --workspace @ana-psi/admin --",
    "test:persistence:admin": "npm run test:persistence --workspace @ana-psi/admin"
  }
}
